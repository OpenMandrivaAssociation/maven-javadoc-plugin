Name:           maven-javadoc-plugin
Version:        3.12.0
Release:        1
Summary:        Maven Javadoc Plugin
Group:          Development/Java
License:        ASL 2.0
URL:            https://maven.apache.org/plugins/maven-javadoc-plugin
BuildArch:      noarch
# Literal, so the first rpmbuild -bs records them before sysjar is installed.
BuildRequires:	maven
BuildRequires:	java-current-devel
# Xpp3Dom still lives in plexus-utils 3. plexus-xml is the 4.x split.
# plexus-interactivity-api is a compile dependency the sources never import.
# reporting-impl is provided and unused. The mojos import the reporting API.
%global sysjar_drops --drop org.codehaus.plexus:plexus-xml --drop org.codehaus.plexus:plexus-interactivity-api --drop org.apache.maven.reporting:maven-reporting-impl
# The options classes are generated by modello. The bootstrap jars are the
# stage-0 generator only. A narrow root keeps every other bootstrap jar out.
# parents.xml is copied in because an explicit root skips the parent fallback.
%define sysjar_bootstrap_root %{builddir}/maven-javadoc-plugin-maven-javadoc-plugin-%{version}/plugin-bootstrap
BuildSystem:	maven
BuildOption:	-Dmaven.javadoc.skip=true

Source0:        https://github.com/apache/maven-javadoc-plugin/archive/refs/tags/maven-javadoc-plugin-%{version}.tar.gz
Source1:	stage0-modello.xml

BuildRequires:	javapackages-bootstrap
BuildRequires:	maven-plugins-pom
BuildRequires:	mvn(org.apache:apache:pom::)
BuildRequires:	mvn(org.apache.maven:maven-parent:pom::)
BuildRequires:	mvn(org.apache.maven.shared:maven-shared-components:pom::)
BuildRequires:	mvn(org.codehaus.plexus:plexus:pom::)
BuildRequires:	mvn(org.apache.commons:commons-parent:pom::)
BuildRequires:	mvn(org.apache.httpcomponents:httpcomponents-parent:pom::)
BuildRequires:	mvn(org.apache.maven:maven-core)
BuildRequires:	mvn(org.apache.maven:maven-model)
BuildRequires:	mvn(org.apache.maven:maven-settings)
BuildRequires:	mvn(org.apache.maven:maven-plugin-api)
BuildRequires:	mvn(org.apache.maven:maven-artifact)
BuildRequires:	mvn(org.apache.maven.plugin-tools:maven-plugin-annotations)
BuildRequires:	mvn(org.apache.maven.resolver:maven-resolver-api)
BuildRequires:	mvn(org.apache.maven.resolver:maven-resolver-util)
BuildRequires:	mvn(javax.inject:javax.inject)
BuildRequires:	mvn(org.apache.maven.reporting:maven-reporting-api)
BuildRequires:	mvn(org.apache.maven:maven-archiver)
BuildRequires:	mvn(org.apache.maven.shared:maven-invoker)
BuildRequires:	mvn(org.apache.maven.shared:maven-shared-utils)
BuildRequires:	mvn(org.apache.maven.shared:maven-common-artifact-filters)
BuildRequires:	mvn(org.apache.maven.doxia:doxia-sink-api)
BuildRequires:	mvn(org.apache.maven.doxia:doxia-site-renderer)
BuildRequires:	mvn(org.apache.maven.doxia:doxia-integration-tools)
BuildRequires:	mvn(org.apache.maven.wagon:wagon-provider-api)
BuildRequires:	mvn(org.apache.commons:commons-lang3)
BuildRequires:	mvn(org.apache.commons:commons-text)
BuildRequires:	mvn(org.apache.httpcomponents:httpclient)
BuildRequires:	mvn(org.apache.httpcomponents:httpcore)
BuildRequires:	mvn(org.slf4j:slf4j-api)
BuildRequires:	mvn(org.codehaus.plexus:plexus-java)
BuildRequires:	mvn(org.codehaus.plexus:plexus-utils)
BuildRequires:	mvn(org.sonatype.plexus:plexus-build-api)
BuildRequires:	mvn(org.eclipse.sisu:org.eclipse.sisu.plexus)
BuildRequires:	mvn(org.codehaus.plexus:plexus-io)
BuildRequires:	mvn(org.codehaus.plexus:plexus-archiver)
BuildRequires:	mvn(commons-io:commons-io)

%description
The Maven Javadoc Plugin is a plugin that uses the javadoc tool for
generating javadocs for the specified project.
 
%package javadoc
Summary:        Javadoc for %{name}

%description javadoc
API documentation for %{name}.

%prep
%setup -q -n maven-javadoc-plugin-maven-javadoc-plugin-%{version}
mkdir -p plugin-bootstrap/usr/share/javapackages-bootstrap/maven-metadata
cp -f %{SOURCE1} plugin-bootstrap/usr/share/javapackages-bootstrap/maven-metadata/modello.xml
cp -f /usr/share/sysjar/parents/maven-metadata/parents.xml plugin-bootstrap/usr/share/javapackages-bootstrap/maven-metadata/parents.xml

%files -f .mfiles
%doc LICENSE README.md

%files javadoc
%doc LICENSE README.md 
